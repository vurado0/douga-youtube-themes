{
  "manifest_version": 3,
  "name": "DOUGA どうが — Japanese Themes for YouTube",
  "short_name": "DOUGA",
  "version": "1.0.0",
  "description": "Five hand-made Japanese theme packs for YouTube — Shirokuro, Washi, Sakura Pop, Neon Yoichi and 8-Bit Pocket.",
  "homepage_url": "https://github.com/vurado0/douga-youtube-themes",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DOUGA themes",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "douga-themes@vurado0.github.io",
      "strict_min_version": "109.0"
    }
  }
}
